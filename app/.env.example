# Required for research, writing, and DeepSeek Search & Fetch
DEEPSEEK_API_KEY=
ATLAS_PRO_MODEL=deepseek-v4-pro
ATLAS_FLASH_MODEL=deepseek-flash

# Optional fallback and image search for interactive runs.
TAVILY_API_KEY=
# Unset by default: interactive runs prefer DeepSeek with optional failover.
# Set deepseek below to use DeepSeek exclusively for web search.
# ATLAS_SEARCH_ENGINE=deepseek
